<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#ffffff"><meta name="description" content="A personal site with a PokÃ©mon bot and some math practice."><title>my site</title><link rel="icon" href="./site-icon.svg" type="image/svg+xml"><link rel="manifest" href="./manifest.webmanifest"><link rel="stylesheet" href="./site.css"><script defer src="./practice-problems.js"></script><script defer src="./site.js"></script></head>
<body><a class="skip" href="#content">Skip to content</a><div class="page">
<header><a class="site-name" href="#home">my site</a><nav role="tablist" aria-label="Pages">
