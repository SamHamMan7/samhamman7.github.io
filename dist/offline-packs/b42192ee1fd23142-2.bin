var BattleNatures={};
for(var natureName in BattleNatureData){
var name=natureName;
var data=BattleNatureData[name];
BattleNatures[name]=Object.assign({},
data,{
id:name.toLowerCase(),
name:name,
gen:3,
effectType:'Nature',
exists:true});

}

