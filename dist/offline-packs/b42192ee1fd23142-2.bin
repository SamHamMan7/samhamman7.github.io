  {id:'cash',n:'Windfall',d:`Gain ${mo('$8')}`},
  {id:'insight',n:'Insight',d:'Level up 2 random clear types'},
  {id:'charm',n:'Charm',d:'Gain 2 random runes (if room)'},
  {id:'patron',n:'Patron',d:'Gain a random Common relic (if room)'},
