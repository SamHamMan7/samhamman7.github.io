showPokemonTooltip=function showPokemonTooltip(
clientPokemon,serverPokemon,isActive,illusionIndex)
{var _this3=this;
var pokemon=clientPokemon||serverPokemon;
var text='';
var genderBuf='';
var gender=pokemon.gender;
if(gender==='M'||gender==='F'){
var genderName=TL.gender[gender==='M'?'male':'female']||gender;
genderBuf=" <img src=\""+Dex.fxPrefix+"gender-"+gender.toLowerCase()+".png\" alt=\""+BattleLog.escapeHTML(genderName)+"\" width=\"7\" height=\"10\" class=\"pixelated\" /> ";
}

var nickname=this.getNickname(pokemon);
var name=BattleLog.escapeHTML(nickname);
var speciesName=TL(this.battle.dex.species.get(pokemon.speciesForme));
if(speciesName!==nickname){

var speciesSuffix=BattleTextParser.defaultText('fullName',{NICKNAME:'',SPECIES:speciesName});
name+="<small>"+speciesSuffix+"</small>";
}

var levelBuf=pokemon.level!==100?" <small>"+TL(["Level"])+" "+pokemon.level+"</small>":"";
if(!illusionIndex||illusionIndex===1){
text+="<h2>"+name+genderBuf+(illusionIndex?'':levelBuf)+"<br />";

if(clientPokemon!=null&&clientPokemon.volatiles.formechange){
var forme=TL(this.battle.dex.species.get(clientPokemon.volatiles.formechange[1]));
if(clientPokemon.volatiles.transform){
text+="<small>"+TL(["(Transformed into ",")"],forme)+"</small><br />";
}else{
text+="<small>"+TL(["(Changed forme: ",")"],forme)+"</small><br />";
}
}

var types=serverPokemon!=null&&serverPokemon.terastallized?[serverPokemon.teraType]:this.getPokemonTypes(pokemon);
var knownPokemon=serverPokemon||clientPokemon;

if(pokemon.terastallized){
text+="<small>(Terastallized)</small><br />";
}else if(clientPokemon!=null&&clientPokemon.volatiles.typechange||clientPokemon!=null&&clientPokemon.volatiles.typeadd){
text+="<small>(Type changed)</small><br />";
}
text+="<span class=\"textaligned-typeicons\">"+types.map(function(type){return Dex.getTypeIcon(type);}).join(' ')+"</span>";
if(pokemon.terastallized){
var baseTypes="<span class=\"textaligned-typeicons\">"+this.getPokemonTypes(pokemon,true).map(function(type){return Dex.getTypeIcon(type);}).join(' ')+"</span>";
text+="&nbsp; &nbsp; <small>"+TL(["(base: ",")"],baseTypes)+"</small>";
}else if(knownPokemon.teraType){
var teraType="<span class=\"textaligned-typeicons\">"+Dex.getTypeIcon(knownPokemon.teraType)+"</span>";
var teraTypeText=TL(["Tera ",""],teraType);
text+="&nbsp; &nbsp; <small>("+teraTypeText+")</small>";
}
text+="</h2>";
}

if(illusionIndex){
text+="<p class=\"tooltip-section\"><strong>"+TL(["Possible Illusion #",""],illusionIndex)+"</strong>"+levelBuf+"</p>";
}

var hpName=TL.stat.hp||'HP';
var faintedName=TL.status.fnt||'fainted';
var statusName=pokemon.status?TL.status[pokemon.status]||pokemon.status.toUpperCase():'';
var status=pokemon.status?" <span class=\"status "+
pokemon.status+"\">"+statusName+"</span>":'';
if(pokemon.fainted&&pokemon.maxhp===100){
text+="<p><small>"+TL.label(hpName)+"</small>("+faintedName+")</p>";
}else if(pokemon.fainted){
text+="<p><small>"+TL.label(hpName)+"</small><span class=\"gray\">0/"+pokemon.maxhp+" ("+faintedName+")</span></p>";
}else if(this.battle.hardcoreMode){
if(serverPokemon){
text+="<p><small>"+TL.label(hpName)+"</small>"+serverPokemon.hp+"/"+serverPokemon.maxhp+status+"</p>";
}
}else{
var exacthp='';
if(serverPokemon){
exacthp=" ("+serverPokemon.hp+"/"+serverPokemon.maxhp+")";
}else if(pokemon.maxhp===48){
exacthp=" <small>"+TL(["(","/"," pixels)"],pokemon.hp,pokemon.maxhp)+"</small>";
}
text+="<p><small>"+TL.label(hpName)+"</small>"+Pokemon.getHPText(pokemon,this.battle.reportExactHP)+exacthp+status;
if(clientPokemon){
if(pokemon.status==='tox'){
if(pokemon.ability==='Poison Heal'||pokemon.ability==='Magic Guard'){
var percent=Math.floor(100/16*Math.min(clientPokemon.statusData.toxicTurns+1,15));
text+=" <small>"+TL(["Would take if ability removed: ","%"],percent)+"</small>";
}else{
var _percent=Math.floor(
100/(clientPokemon.volatiles['dynamax']?32:16)*Math.min(clientPokemon.statusData.toxicTurns+1,15)
);
text+=" "+TL(["Next damage: ","%"],_percent);
}
}else if(pokemon.status==='slp'){
text+=" "+TL(["Turns asleep: ",""],clientPokemon.statusData.sleepTurns);
}
}
text+='</p>';
}

var supportsAbilities=this.battle.gen>2&&!this.battle.tier.includes("Let's Go");

var abilityText='';
if(supportsAbilities){
abilityText=this.getPokemonAbilityText(
clientPokemon,serverPokemon,isActive,!!illusionIndex&&illusionIndex>1
);
}

var itemText='';
if(serverPokemon){
var item='';
var itemEffect='';
if(clientPokemon!=null&&clientPokemon.prevItem){
item='None';
var prevItem=TL(this.battle.dex.items.get(clientPokemon.prevItem));
itemEffect+=clientPokemon.prevItemEffect?prevItem+' was '+clientPokemon.prevItemEffect:'was '+prevItem;
