const ART_CACHE={};
function relicArt(id){
  if(ART_CACHE[id])return ART_CACHE[id];
  const a=ART[id]||ART._,h=a.length,w=Math.max(...a.map(r=>r.length));
  let rects='';
  a.forEach((row,y)=>{for(let x=0;x<row.length;x++){const col=PAL[row[x]];if(col)rects+=`<rect x="${x}" y="${y}" width="1.04" height="1.04" fill="${col}"/>`;}});
  return ART_CACHE[id]=`<svg class="rart" viewBox="-1 -1 ${w+2} ${h+2}" shape-rendering="crispEdges" aria-hidden="true">${rects}</svg>`;
}

const RD=Object.fromEntries(RELICS.map(r=>[r.id,r]));
const RAR=['','Common','Uncommon','Rare'];
const FIN={
  chrome:{n:'Chrome',d:ch('+50 Points'),fx:{chips:50},cost:2},
  neon:{n:'Neon',d:mu('+10 Mult'),fx:{mult:10},cost:3},
  prism:{n:'Prism',d:xm('X1.5 Mult'),fx:{xmult:1.5},cost:5}
};

/* ---------- runes ---------- */
const enhRune=(n,g,e,max)=>({n,g,max:1,d:`The selected piece becomes <b>${ENH[e].n}</b>`,target:1,use:cs=>cs.forEach(c=>{c.enh=e;})});
const settleGrid=()=>{const R=G.round,N=R.N;let moved=0;for(let x=0;x<N;x++){const col=[];for(let y=N-1;y>=0;y--){const c=R.board[y*N+x];if(c&&!c.iron)col.push([c,y]);}let k=0;for(let y=N-1;y>=0;y--){if(R.board[y*N+x]&&R.board[y*N+x].iron)continue;const e=col[k++];R.board[y*N+x]=e?e[0]:null;if(e&&e[1]!==y){moved++;e[0].nw=1;}}}return moved;};
const RUNES={
  spark:enhRune('Spark','áš ','bonus',2), ember:enhRune('Ember','áš²','mult',2), lens:enhRune('Lens','á›','glass',1),
  gild:enhRune('Gild','áš·','gold',2), temper:enhRune('Temper','á›','steel',1), clover:enhRune('Clover','á›œ','lucky',2), chroma:enhRune('Chroma','á›','wild',2),
  dyeR:{n:'Crimson Dye',g:'áš±',tray:1,d:'Every piece in your tray turns Ruby',use:cs=>cs.forEach(c=>{c.hue='R';})},
  dyeB:{n:'Azure Dye',g:'á›’',tray:1,d:'Every piece in your tray turns Sapphire',use:cs=>cs.forEach(c=>{c.hue='B';})},
  dyeG:{n:'Verdant Dye',g:'áš¹',tray:1,d:'Every piece in your tray turns Emerald',use:cs=>cs.forEach(c=>{c.hue='G';})},
  dyeY:{n:'Amber Dye',g:'á›ƒ',tray:1,d:'Every piece in your tray turns Topaz',use:cs=>cs.forEach(c=>{c.hue='Y';})},
  grow:{n:'Grow',g:'á›Š',max:2,d:'The selected piece gains 1 cell (new shape, max 5)',target:1,use:cs=>cs.forEach(c=>{c.shape=rnd(BY_SIZE[Math.min(5,size(c)+1)]);c.rot=0;})},
  shrink:{n:'Shrink',g:'á›š',max:2,d:'The selected piece loses 1 cell (new shape, min 1)',target:1,use:cs=>cs.forEach(c=>{c.shape=rnd(BY_SIZE[Math.max(1,size(c)-1)]);c.rot=0;})},
  straighten:{n:'Straighten',g:'á›á›',max:2,d:'The selected piece becomes a straight bar of the same size',target:1,use:cs=>cs.forEach(c=>{c.shape={1:'m1',2:'d2',3:'i3',4:'I4',5:'I5'}[size(c)];c.rot=0;})},
  mitosis:{n:'Mitosis',g:'á›—',max:1,d:'Add a copy of the selected piece to your bag',target:1,use:cs=>cs.forEach(c=>{const n=mk(c.shape,c.enh,c.hue);addToDeck(n);G.draw.splice(Math.floor(Math.random()*(G.draw.length+1)),0,n);})},
  erase:{n:'Erase',g:'áš¾',max:1,d:'Destroy the selected piece for good',target:1,use:cs=>{G.deck=G.deck.filter(x=>!cs.includes(x));G.hand=G.hand.filter(x=>!cs.includes(x));}},
  quake:{n:'Quake',g:'á›ˆ',d:'Every block on the grid falls to the bottom of its column. Use during a stage',round:1,use:settleGrid},
  purge:{n:'Purge',g:'á›',d:'Clear every cell on the grid (no score). Use during a stage',round:1,use:()=>{const R=G.round;R.board=R.board.map(c=>c&&c.iron?c:null);}},
  hoard:{n:'Hoard',g:'ášº',d:`Double your money (max ${mo('+$20')})`,use:()=>{G.money+=Math.min(Math.max(G.money,0),20);}},
  conjure:{n:'Conjure',g:'á›‰',d:'Create a random Common or Uncommon relic (needs room)',use:()=>{const r=randRelic(2);if(r){G.relics.push(newRelic(r.id));toast(`${r.n} appeared!`);}}},
  rift:{n:'Rift',g:'âœ¶',anom:1,d:'Anomaly. Give a random relic the Prism finish, then destroy a different random relic',use:()=>{const plain=G.relics.filter(r=>!r.f);if(!plain.length){toast('No relic can take a finish');return false;}const t=rnd(plain);t.f='prism';const others=G.relics.filter(r=>r!==t);if(others.length){const d=rnd(others);G.relics.splice(G.relics.indexOf(d),1);toast(`${RD[t.id].n} turned Prism, ${RD[d.id].n} was destroyed`);}else toast(`${RD[t.id].n} turned Prism`);}},
  expand:{n:'Expand',g:'âœ·',anom:1,d:'Anomaly. +1 tray size for the rest of the run, but -1 swap each stage',use:()=>{G.baseTS++;G.baseSW=Math.max(0,G.baseSW-1);toast('Your tray grows');}},
  echoRune:{n:'Mirror',g:'âœ¹',anom:1,d:'Anomaly. Copy a random relic you own (needs room)',use:()=>{if(!G.relics.length||G.relics.length>=relicSlots()){toast('Needs a relic and a free slot');return false;}const r=rnd(G.relics);G.relics.push({id:r.id,v:r.v,f:null});toast(`${RD[r.id].n} copied`);}}
};
const RK=Object.keys(RUNES).filter(k=>!RUNES[k].anom),ANOM=Object.keys(RUNES).filter(k=>RUNES[k].anom);

