  {id:'wall',n:'The Wall',icon:'â–¦',col:'#8a6f5a',d:'The grid starts with 10 stone cells'},
  {id:'riser',n:'The Riser',icon:'â‡ˆ',col:'#6a5a9e',d:'After every deal, a garbage row rises from the bottom'},
