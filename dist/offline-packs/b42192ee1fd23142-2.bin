y:attacker.y,
z:attacker.z,
scale:0.6,
opacity:0.8,
time:225
},{
x:defender.x-20,
y:defender.y+10,
z:defender.z,
scale:2,
opacity:0.5
},'decel','explode');

defender.delay(200);
defender.anim({
x:defender.x-5,
time:75
},'swing');
defender.anim({
x:defender.x+5,
time:75
},'swing');
defender.anim({
x:defender.x-5,
time:75
},'swing');
defender.anim({
x:defender.x+5,
time:75
},'swing');
defender.anim({
x:defender.x-5,
time:75
},'swing');
defender.anim({
