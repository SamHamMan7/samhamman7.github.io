//# sourceMappingURL=battle-searchresults.js.map{"version":3,"file":"battle-searchresults.js","names":["RESULT_ROW_HEIGHT","RESULT_OVERSCAN_ROWS","RESULT_REFILL_THRESHOLD_ROWS","escapeHTML","text","test","replace","escapeCSSString","getSearchDisplayName","search","type","name","dex","get","species","moves","items","abilities","typeName","categoryName","eggGroupName","getLocalizedMatch","canonicalName","matchStart","matchEnd","PSSearchResults","_preact$Component","_this","_len","arguments","length","args","Array","_key","call","apply","concat","URL_ROOT","Config","routes","speciesId","itemId","abilityId","moveIds","scrollFrame","renderedStart","renderedEnd","renderedLength","handleClick","ev","props","target","className","tagName","entry","getAttribute","_entry$split","split","slot","addFilter","onSelect","query","find","forceUpdate","preventDefault","stopImmediatePropagation","page","pageResults","parseInt","stopPropagation","filter","removeFilter","sort","toggleSort","parentElement","handleMouseDown","hasAttribute","handleScroll","_this$base","base","scrollTop","document","documentElement","clientWidth","scrollWidth","scrollIntoViewIfNeeded","requestAnimationFrame","updateDOM","_inheritsLoose","_proto","prototype","renderPokemonSortRowHTML","index","sortCol","abilityWidthClass","numAbilityCols","firstPokemonColumn","TL","statShort","hp","atk","def","gen","spc","spa","spd","spe","tag","bst","join","renderMoveSortRowHTML","renderPokemonRowHTML","id","errorMessage","pokemon","pokemonText","displayName","_getLocalizedMatch","baseIndex","baseSpecies","indexOf","baseStart","Math","max","baseEnd","stats","baseStats","_i2","_Object$values2","Object","values","stat","buf","getTier","Dex","getPokemonIcon","renderNameHTML","types","map","resourcePrefix","ability0","ability1","hiddenAbility","specialAbility","unreleasedHidden","tagStart","tagEnd","undefined","renderPart","start","end","slice","boldStart","boldEnd","min","output","renderItemRowHTML","item","itemText","_getLocal