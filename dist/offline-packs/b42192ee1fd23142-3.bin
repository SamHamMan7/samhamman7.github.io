.dark .battle-log {
	background: #333333;
	color: #CCCCCC;
}
.dark .chooser {
	background: #666666;
	color: #CCCCCC;
}
.dark .chooser em {
	background: #777777;
	color: #CCCCCC;
}
.dark .chooser button {
	color: #CCCCCC;
}
.dark .chooser button:hover {
	border: 1px solid #BBBBBB;
	padding: 1px 3px;
	background: #777777;
	color: #EEEEEE;
