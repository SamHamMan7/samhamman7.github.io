window.PRACTICE_PROBLEMS = [
  {id:'amc-01',set:'AMC',topic:'Algebra',title:'A reciprocal expression',statement:'A nonzero real number x satisfies x + 1/x = 3. What is xÂ² + 1/xÂ²?',choices:['5','6','7','8','9'],answer:2,hint:'Square the given equation. Remember the cross term.',solution:'(x + 1/x)Â² = xÂ² + 2 + 1/xÂ² = 9. Subtract 2 to get xÂ² + 1/xÂ² = 7. Answer: C.'},
  {id:'amc-02',set:'AMC',topic:'Probability',title:'Two dice',statement:'Two fair six-sided dice are rolled. What is the probability that their sum is 8?',choices:['1/9','5/36','1/6','7/36','2/9'],answer:1,hint:'Count ordered pairs of results, not just unordered pairs.',solution:'There are 36 equally likely ordered outcomes. The five favorable outcomes are (2,6), (3,5), (4,4), (5,3), and (6,2). The probability is 5/36. Answer: B.'},
  {id:'amc-03',set:'AMC',topic:'Geometry',title:'An inscribed circle',statement:'A right triangle has legs of lengths 9 and 12. What is the radius of its inscribed circle?',choices:['2','5/2','3','4','5'],answer:2,hint:'Use area = inradius Ã— semiperimeter.',solution:'The hypotenuse is 15, so the semiperimeter is (9 + 12 + 15)/2 = 18. The area is 9 Ã— 12 / 2 = 54. Therefore r = 54/18 = 3. Answer: C.'},
  {id:'amc-04',set:'AMC',topic:'Counting',title:'Rectangles in a grid',statement:'A rectangular grid has 3 rows and 4 columns of unit squares. How many rectangles have all four sides on grid lines?',choices:['24','36','48','60','72'],answer:3,hint:'A rectangle is determined by two horizontal and two vertical grid lines.',solution:'There are 4 horizontal grid lines and 5 vertical grid lines. Choose 2 of each: C(4,2) Ã— C(5,2) = 6 Ã— 10 = 60. Answer: D.'},
  {id:'amc-05',set:'AMC',topic:'Number theory',title:'A last digit',statement:'What is the units digit of 7Â²â°Â²â¶?',choices:['1','3','5','7','9'],answer:4,hint:'Look at the units digits of the first few powers of 7.',solution:'The units digits repeat in the cycle 7, 9, 3, 1, of length 4. Since 2026 leaves remainder 2 when divided by 4, the required digit is the second in the cycle: 9. Answer: E.'},
  {id:'amc-06',set:'AMC',topic:'Geometry',title:'Rectangles in a hexagon',statement:'How many rectangles have all four vertices among the vertices of a regular hexagon?',choices:['2','3','6','9','12'],answer:1,hint:'The diagonals of an inscribed rectangle pass through the circleâ€™s center.',solution:'Each diagonal of a rectangle inscribed in a circle is a diameter. The hexagon has 3 pairs of opposite vertices, so it has 3 possible diameters. Choosing any 2 gives exactly one rectangle. Thus there are C(3,2) = 3 rectangles. Answer: B.'},
  {id:'amc-07',set:'AMC',topic:'Counting',title:'Three distinct integers',statement:'How many triples of positive integers (x, y, z) satisfy x < y < z and x + y + z = 12?',choices:['6','7','8','9','10'],answer:1,hint:'Try fixing x. The inequalities put a small upper bound on it.',solution:'For x = 1, the pairs (y,z) are (2,9), (3,8), (4,7), (5,6): 4 choices. For x = 2, they are (3,7), (4,6): 2 choices. For x = 3, only (4,5) works. No larger x is possible. Total: 4 + 2 + 1 = 7. Answer: B.'},
  {id:'amc-08',set:'AMC',topic:'Algebra',title:'Powers of roots',statement:'The roots of tÂ² âˆ’ 5t + 3 = 0 are a and b. What is aÂ³ + bÂ³?',choices:['65','70','75','80','85'],answer:3,hint:'Use a + b and ab instead of finding either root.',solution:'By Vietaâ€™s formulas, a + b = 5 and ab = 3. Hence aÂ³ + bÂ³ = (a + b)Â³ âˆ’ 3ab(a + b) = 125 âˆ’ 45 = 80. Answer: D.'},
  {id:'aime-01',set:'AIME',topic:'Number theory',title:'Divisors with a condition',statement:'How many positive divisors of 2025 are divisible by 15?',answer:8,hint:'Write 2025 as a product of prime powers.',solution:'2025 = 3â´ Ã— 5Â². A divisor divisible by 15 has the form 3áµƒ5áµ‡ with 1 â‰¤ a â‰¤ 4 and 1 â‰¤ b â‰¤ 2. This gives 4 Ã— 2 = 8 divisors. Answer: 008.'},
  {id:'aime-02',set:'AIME',topic:'Counting',title:'Separated ones',statement:'How many strings of ten digits, each digit either 0 or 1, contain exactly four 1s with no two 1s adjacent?',answer:35,hint:'Arrange the six 0s first. Where can the 1s go?',solution:'The six 0s create seven gaps, including the two ends. To keep the 1s separated, place at most one 1 in each gap. Choose 4 of the 7 gaps: C(7,4) = 35. Answer: 035.'},
  {id:'aime-03',set:'AIME',topic:'Algebra',title:'A short recurrence',statement:'A sequence satisfies aâ‚ = 2, aâ‚‚ = 5, and aâ‚™ = 3aâ‚™â‚‹â‚ âˆ’ aâ‚™â‚‹â‚‚ for n â‰¥ 3. Find aâ‚†.',answer:233,hint:'Compute the terms in order, keeping the last two each time.',solution:'aâ‚ƒ = 3(5) âˆ’ 2 = 13. Then aâ‚„ = 39 âˆ’ 5 = 34, aâ‚… = 102 âˆ’ 13 = 89, and aâ‚† = 267 âˆ’ 34 = 233. Answer: 233.'},
  {id:'aime-04',set:'AIME',topic:'Number theory',title:'A reciprocal equation',statement:'How many ordered pairs of positive integers (a, b) satisfy 1/a + 1/b = 1/12?',answer:15,hint:'Clear denominators and then add a constant to factor.',solution:'The equation becomes ab = 12a + 12b, so (a âˆ’ 12)(b âˆ’ 12) = 144. Both a and b must be greater than 12. Each positive divisor d of 144 gives exactly one ordered pair a = 12 + d, b = 12 + 144/d. Since 144 = 2â´ Ã— 3Â², it has (4 + 1)(2 + 1) = 15 divisors. Answer: 015.'},
  {id:'aime-05',set:'AIME',topic:'Number theory',title:'Zeros in another base',statement:'How many trailing zero digits appear when 100! is written in base 12?',answer:48,hint:'One trailing zero in base 12 uses a factor of 12 = 2Â² Ã— 3.',solution:'The exponent of 2 in 100! is 50 + 25 + 12 + 6 + 3 + 1 = 97. The exponent of 3 is 33 + 11 + 3 + 1 = 48. Therefore the largest k with 12áµ dividing 100! is min(floor(97/2), 48) = 48. Answer: 048.'},
  {id:'aime-06',set:'AIME',topic:'Geometry',title:'Lattice points in a disk',statement:'How many ordered pairs of integers (x, y) satisfy xÂ² + yÂ² â‰¤ 25?',answer:81,hint:'For each integer x from âˆ’5 to 5, count the allowed values of y.',solution:'For x = 0 there are 11 choices of y. For each of |x| = 1, 2, 3 there are 9 choices of y. For |x| = 4 there are 7, and for |x| = 5 there is 1. Count both signs of nonzero x: 11 + 2(9 + 9 + 9 + 7 + 1) = 81. Answer: 081.'},
  {id:'aime-07',set:'AIME',topic:'Algebra',title:'A sum of floors',statement:'Find the value of floor(1/7) + floor(2/7) + â€¦ + floor(99/7), where floor(t) is the greatest integer not exceeding t.',answer:665,hint:'Group together numerators that give the same floor value.',solution:'The terms for n = 1 through 6 contribute 0. Each floor value from 1 through 13 occurs seven times, from n = 7 through 97. The final two terms, n = 98 and 99, each contribute 14. Thus the sum is 7(1 + 2 + â€¦ + 13) + 28 = 7 Ã— 91 + 28 = 665. Answer: 665.'},
  {id:'aime-08',set:'AIME',topic:'Geometry',title:'A circumradius',statement:'A triangle has side lengths 13, 14, and 15. If R is the radius of its circumscribed circle, find 8R.',answer:65,hint:'Use Heronâ€™s formula for the area, then R = abc/(4 Ã— area).',solution:'The semiperimeter is 21. Heronâ€™s formula gives area = âˆš(21 Ã— 8 Ã— 7 Ã— 6) = 84. Hence R = (13 Ã— 14 Ã— 15)/(4 Ã— 84) = 65/8, so 8R = 65. Answer: 065.'}
