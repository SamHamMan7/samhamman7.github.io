			onVolumeChangeCapture?: GenericEventHandler;
			onWaiting?: GenericEventHandler;
			onWaitingCapture?: GenericEventHandler;

			// MouseEvents
			onClick?: MouseEventHandler;
			onClickCapture?: MouseEventHandler;
