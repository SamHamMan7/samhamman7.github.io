			var index = this.roomList.indexOf(room);
			if (index >= 0) this.roomList.splice(index, 1);
			index = this.sideRoomList.indexOf(room);
			if (index >= 0) this.sideRoomList.splice(index, 1);
			room.destroy(alreadyLeft);
