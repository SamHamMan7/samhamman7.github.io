			onMouseDown?: MouseEventHandler;
			onMouseDownCapture?: MouseEventHandler;
			onMouseEnter?: MouseEventHandler;
			onMouseEnterCapture?: MouseEventHandler;
			onMouseLeave?: MouseEventHandler;
			onMouseLeaveCapture?: MouseEventHandler;
