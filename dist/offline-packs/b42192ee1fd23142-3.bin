:root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#262626;background:#fff;font-size:16px;line-height:1.65;color-scheme:light}*{box-sizing:border-box}body{margin:0}a{color:#245fa0;text-underline-offset:3px}a:hover{color:#143e6c}button,input,select{font:inherit}button,.button{border:1px solid #b9bec4;border-radius:4px;background:#f5f6f7;color:#262626;cursor:pointer;display:inline-block;padding:7px 13px;text-decoration:none;line-height:1.5;min-height:40px}button:hover,.button:hover{background:#e9edf1;color:#262626}button:disabled{opacity:.6;cursor:wait}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:2px solid #245fa0;outline-offset:4px}.page{max-width:790px;margin:0 auto;padding:0 25px}.site-name{font-size:18px;font-weight:600;color:#262626;text-decoration:none}header{padding-top:34px}nav{display:flex;flex-wrap:wrap;gap:6px 22px;border-bottom:1px solid #ddd;margin-top:20px}nav a{font-size:14px;text-decoration:none;color:#60646a;padding:8px 0 11px;min-height:43px;border-bottom:2px solid transparent;margin-bottom:-1px}nav a[aria-selected=true]{color:#222;font-weight:600;border-bottom-color:#555}main{min-height:420px;padding:27px 0 42px}h1{font-size:26px;line-height:1.3;font-weight:600;margin:0 0 22px;letter-spacing:-.4px}h2{font-size:19px;line-height:1.4;font-weight:600;margin:31px 0 12px}p{margin:0 0 17px}.tab-panel{outline:none}.tab-panel[hidden],[hidden]{display:none!important}li{margin:8px 0}.small{font-size:13px}.muted{color:#666b72}footer{border-top:1px solid #e4e4e4;padding:16px 0 25px;font-size:12px}footer a{color:#70757b}.skip{position:absolute;left:12px;top:-100px;padding:8px;background:#fff;z-index:10}.skip:focus{top:8px}progress{display:block;width:100%;max-width:380px;height:7px;margin:16px 0;accent-color:#245fa0}#download-status{margin-top:15px}.practice-tools{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;margin:27px 0 30px}.practice-tools label{font-size:13px;display:flex;flex-direction:column;gap:5px}select{border:1px solid #b9bec4;border-radius:3px;padding:7px;background:#fff;max-width:300px;min-height:40px;font-size:14px}#problem-picker{width:290px}.problem{border-top:1px solid #e4e4e4;border-bottom:1px solid #e4e4e4;padding:22px 0}#problem-category{margin:0 0 4px}#problem-title{margin:0 0 18px;font-size:20px}#problem-statement{white-space:pre-line;margin-bottom:23px}fieldset{border:0;padding:0;margin:0 0 18px}legend{font-size:13px;color:#666b72;padding:0;margin-bottom:9px}fieldset label{display:block;font-size:15px;width:max-content;max-width:100%;padding:6px 4px;cursor:pointer}fieldset input{margin:0 9px 0 0;accent-color:#245fa0}#integer-answer>label{display:block;font-size:13px;margin-bottom:7px}#answer-integer{width:110px;padding:7px 10px;border:1px solid #b9bec4;border-radius:3px;margin-bottom:8px}#integer-help{margin-bottom:18px}#answer-feedback{font-size:14px;min-height:23px;margin:12px 0 17px}#answer-feedback.correct{color:#245f33}#answer-feedback.incorrect{color:#963a32}details{margin:13px 0}summary{cursor:pointer;width:max-content;font-size:14px;color:#4c535c}details p{margin:12px 0 17px;white-space:pre-line;font-size:15px}.problem-navigation{display:flex;justify-content:space-between;gap:12px;align-items:center;padding-top:18px}.problem-navigation button{font-size:13px}.credits{max-width:790px;margin:38px auto;padding:0 25px;line-height:1.7}.credits h1{margin-top:30px}.credits p,.credits li{font-size:14px}.credits small{color:#666b72}@media(max-width:530px){.page{padding:0 19px}header{padding-top:24px}nav{gap:4px 17px}nav a{font-size:12px}main{padding-top:24px}h1{font-size:24px}.practice-tools{gap:12px}.practice-tools label:last-of-type{flex:1;min-width:210px}#problem-picker{width:100%;max-width:100%}.practice-tools button{font-size:14px}.problem-navigation{gap:8px}.problem-navigation button{padding:7px 9px;font-size:12px}.problem-navigation .small{font-size:11px}footer{margin-top:0}}
(() => {
  const tabs = [...document.querySelectorAll('[role=tab]')];
  function showTab() {
    const requested = location.hash.slice(1), selected = tabs.find(t => t.hash.slice(1) === requested) || tabs[0];
    for (const tab of tabs) {
      const active = tab === selected;
      tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1;
      document.getElementById(tab.getAttribute('aria-controls')).hidden = !active;
    }
    document.title = selected.textContent === 'Home' ? 'my site' : selected.textContent + ' Â· my site';
  }
  window.addEventListener('hashchange', showTab); showTab();
  document.querySelector('[role=tablist]').addEventListener('keydown', event => {
    const index = tabs.indexOf(document.activeElement);
    if (index < 0) return;
    let target;
    if (event.key === 'ArrowRight') target = tabs[(index + 1) % tabs.length];
    if (event.key === 'ArrowLeft') target = tabs[(index + tabs.length - 1) % tabs.length];
    if (event.key === 'Home') target = tabs[0];
    if (event.key === 'End') target = tabs[tabs.length - 1];
    if (target) { event.preventDefault(); target.focus(); location.hash = target.hash; }
  });

  const problems = window.PRACTICE_PROBLEMS;
  const set = document.getElementById('problem-set'), picker = document.getElementById('problem-picker');
  const answerOptions = document.getElementById('answer-options'), integer = document.getElementById('answer-integer'), feedback = document.getElementById('answer-feedback');
  let filtered = problems, current;
  function showProblem(id) {
    current = filtered.find(p => p.id === id) || filtered[0]; picker.value = current.id;
    document.getElementById('problem-category').textContent = current.set + ' style Â· ' + current.topic;
    document.getElementById('problem-title').textContent = current.title;
    document.getElementById('problem-statement').textContent = current.statement;
    document.getElementById('hint-text').textContent = current.hint;
    document.getElementById('solution-text').textContent = current.solution;
    document.getElementById('problem-hint').open = false; document.getElementById('problem-solution').open = false;
    document.getElementById('problem-position').textContent = `${filtered.indexOf(current) + 1} / ${filtered.length}`;
    const aime = current.set === 'AIME';
    answerOptions.hidden = aime; document.getElementById('integer-answer').hidden = !aime;
    integer.disabled = !aime; integer.required = aime; integer.value = '';
    answerOptions.replaceChildren();
    const legend = document.createElement('legend'); legend.textContent = 'Your answer'; answerOptions.append(legend);
    for (const [index, choice] of (current.choices || []).entries()) {
      const label = document.createElement('label'), input = document.createElement('input');
      input.type = 'radio'; input.name = 'choice'; input.value = index; input.required = true;
      label.append(input, `${String.fromCharCode(65 + index)}. ${choice}`); answerOptions.append(label);
    }
    feedback.textContent = ''; feedback.className = '';
  }
  function fillPicker() {
    filtered = problems.filter(p => set.value === 'all' || p.set === set.value);
    picker.replaceChildren(...filtered.map(p => new Option(p.id.toUpperCase() + ' Â· ' + p.title,p.id)));
    showProblem(filtered[0].id);
  }
  set.addEventListener('change', fillPicker);
  picker.addEventListener('change', () => showProblem(picker.value));
  document.getElementById('random-problem').addEventListener('click', () => {
    const others = filtered.filter(p => p !== current); showProblem(others[Math.floor(Math.random() * others.length)].id);
  });
  document.getElementById('previous-problem').addEventListener('click', () => showProblem(filtered[(filtered.indexOf(current) + filtered.length - 1) % filtered.length].id));
  document.getElementById('next-problem').addEventListener('click', () => showProblem(filtered[(filtered.indexOf(current) + 1) % filtered.length].id));
  document.getElementById('answer-form').addEventListener('submit', event => {
    event.preventDefault();
    const selected = new FormData(event.currentTarget).get(current.set === 'AIME' ? 'integer' : 'choice');
    const correct = selected !== null && String(selected).trim() !== '' && Number(selected) === current.answer;
    feedback.textContent = correct ? 'Correct.' : 'Not quite. Try again, or open the hint.';
    feedback.className = correct ? 'correct' : 'incorrect';
  });
  fillPicker();

  const button = document.getElementById('download-offline');
  const status = document.getElementById('download-status');
  const progress = document.getElementById('download-progress');
  let registration, manifest, downloading = false;
  function show(message) { status.textContent = message; }
  function rpc(worker, type) {
    return new Promise((resolve, reject) => {
      const channel = new MessageChannel();
      const timer = setTimeout(() => reject(new Error('The offline service did not respond. Reload and try again.')), 30000);
      channel.port1.onmessage = ({data}) => { clearTimeout(timer); channel.port1.close(); data.error ? reject(new Error(data.error)) : resolve(data); };
      worker.postMessage({type}, [channel.port2]);
    });
  }
  function update(data) {
    if (data.type === 'download-progress') {
      progress.hidden = false;
      progress.value = Math.round(data.loaded / data.total * 100);
      show(`Downloading ${Math.round(data.loaded / 1048576)} of ${Math.ceil(data.total / 1048576)} MBâ€¦ Keep this page open.`);
    }
    if (data.type === 'download-complete') finish();
    if (data.type === 'download-error') {
      downloading = false; button.disabled = false; button.firstChild.textContent = 'Retry offline download ';
      show(data.error + ' Finished files are kept; you can retry on Wi-Fi.');
    }
  }
  function finish() {
    downloading = false; button.disabled = false; progress.hidden = true;
    button.firstChild.textContent = 'Check offline download ';
    show('Ready for offline. The game and sprites are saved on this device.');
  }
  async function init() {
    if (!('serviceWorker' in navigator)) { button.disabled = true; show('Offline saving is unavailable in this browser. You can still play while online.'); return; }
    try {
      registration = await navigator.serviceWorker.register('./sw.js');
      await navigator.serviceWorker.ready;
      navigator.serviceWorker.addEventListener('message', event => update(event.data));
      const response = await fetch('./offline-manifest.json');
      if (!response.ok) throw new Error('Could not load the download list.');
      manifest = await response.json();
      const result = await rpc(registration.active, 'status');
      if (result.ready) finish();
      else show(`Optional download: about ${Math.ceil(manifest.totalBytes / 1048576)} MB. Use Wi-Fi before your trip.`);
    } catch (error) { show('Offline saving could not start: ' + error.message); }
  }
  button.addEventListener('click', async () => {
    if (downloading) return;
    try {
      if (!registration?.active) throw new Error('Reload this page to start the offline service.');
      const result = await rpc(registration.active, 'status');
      if (result.ready) { finish(); return; }
      downloading = true; button.disabled = true; progress.hidden = false; progress.value = 0;
      show('Preparing the offline downloadâ€¦');
      registration.active.postMessage({type: 'download'});
      navigator.storage?.persist?.().catch(() => {});
    } catch (error) { show(error.message); downloading = false; button.disabled = false; }
  });
  document.addEventListener('visibilitychange', async () => {
    if (!document.hidden && registration?.active) {
      try { const result = await rpc(registration.active, 'status'); if (result.ready) finish(); else if (downloading && !result.downloading) { downloading = false; button.disabled = false; show('Download paused. Press the button to resume.'); } } catch {}
    }
  });
  init();
})();
