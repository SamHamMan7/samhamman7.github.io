 room\r\n\r\nclass ExampleViewPanel extends PSRoomPanel {\r\n\tstatic readonly id = 'exampleview2';\r\n\tstatic readonly routes = ['exampleview2'];\r\n\t// Even without a room model, you can edit `room.title`.\r\n\tstatic readonly title = 'Example View';\r\n\toverride render() {\r\n\t\tconst room = this.props.room;\r\n\t\treturn <PSPanelWrapper room={room}>\r\n\t\t\t<div class=\"mainmessage\"><p>Hello World!</p></div>\r\n\t\t</PSPanelWrapper>;\r\n\t}\r\n}\r\n\r\nPS.addRoomType(ExampleViewPanel);\r\n"],"mappings":"sSAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GAPA;;;;;;;AAcMA,WAAW,UAAAC,OAAA;;;AAGhB,SAAAD,YAAYE,OAAoB,CAAE,KAAAC,KAAA;AACjCA,KAAA,CAAAF,OAAA,CAAAG,IAAA,MAAMF,OAAO,CAAC,OAACC,KAAA,CAHEE,SAAS,CAAW,SAAS,QAAAF,KAAA;AAI/C,CAACG,cAAA,CAAAN,WAAA,CAAAC,OAAA,SAAAD,WAAA,GALwBO,MAAM;;;AAQ1BC,YAAY,UAAAC,YAAA,WAAAD,aAAA,SAAAC,YAAA,CAAAC,KAAA,MAAAC,SAAA,SAAAL,cAAA,CAAAE,YAAA,CAAAC,YAAA,MAAAG,MAAA,CAAAJ,YAAA,CAAAK,SAAA,CAAAD,MAAA;;;;;;;;;;;;AAYRE,MAAM,CAAf,QAAS,CAAAA,MAAMA,CAAA,CAAG;AACjB,GAAM,CAAAC,IAAI,CAAG,IAAI,CAACC,KAAK,CAACD,IAAI;AAC5B,MAAO,CAAAE,MAAA,CAAAC,CAAA,CAACC,cAAc,EAACJ,IAAI,CAAEA,IAAK;AACjCE,MAAA,CAAAC,CAAA,QAAK,QAAM,aAAa,EAACD,MAAA,CAAAC,CAAA,UAAG,cAAe,CAAM;AAClC,CAAC;AAClB,CAAC,QAAAV,YAAA,GAjByBY,WAAW,EAAhCZ,YAAY,CAIDa,EAAE,CAAG,aAAa,CAJ7Bb,YAAY,CAODc,MAAM,CAAG,CAAC,aAAa,CAAE,YAAY,CAAC,CAPjDd,YAAY,CAQDe,KAAK,CAAGvB,WAAW,CAR9BQ,YAAY,CAWDgB,KAAK,CAAG,cAAc;;;AASvCC,EAAE,CAACC,WAAW,CAAClB,YAAY,CAAC,CAAC;;;;AAIvBmB,gBAAgB,UAAAC,aAAA,WAAAD,iBAAA,SAAAC,aAAA,CAAAlB,KAAA,MAAAC,SAAA,SAAAL,cAAA,CAAAqB,gBAAA,CAAAC,aAAA,MAAAC,OAAA,CAAAF,gBAAA,CAAAd,SAAA,CAAAgB,OAAA;;;;;AAKZf,MAAM,CAAf,QAAS,CAAAA,MAAMA,CAAA,CAAG;AACjB,GAAM,CAAAC,IAAI,CAAG,IAAI,CAACC,KAAK,CAACD,IAAI;AAC5B,MAAO,CAAAE,MAAA,CAAAC,CAAA,CAACC,cAAc,EAACJ,IAAI,CAAEA,IAAK;AACjCE,MAAA,CAAAC,CAAA,QAAK,QAAM,aAAa,EAACD,MAAA,CAAAC,CAAA,UAAG,cAAe,CAAM;AAClC,CAAC;AAClB,CAAC,QAAAS,gBAAA,GAV6BP,WAAW,EAApCO,gBAAgB,CACLN,EAAE,CAAG,cAAc,CAD9BM,gBAAgB,CAELL,MAAM,CAAG,CAAC,cAAc,CAAC,CAFpCK,gBAAgB,CAILH,KAAK,CAAG,cAAc;;;AASvCC