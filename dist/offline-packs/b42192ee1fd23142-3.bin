			if (room && room.id === 'rooms') {
				if (!rooms.length) return false;
				this.focusRoom(rooms[amount < 0 ? rooms.length - 1 : 0].id, focusTextbox);
				return true;
			}
			var index = rooms.indexOf(room);
			if (index >= 0) {
