\t\t})}\r\n\t\t\t\t\t{column.map(format => {\r\n\t\t\t\t\t\t// do not include starred formats\r\n\t\t\t\t\t\tif (starred.includes(format.id || '')) return '';\r\n\t\t\t\t\t\tif (format.id) {\r\n\t\t\t\t\t\t\treturn <li><button\r\n\t\t\t\t\t\t\t\tvalue={format.name}\r\n\t\t\t\t\t\t\t\tclass={`option${curFormat === format.id ? ' cur' : ''}`}\r\n\t\t\t\t\t\t\t>\r\n\t\t\t\t\t\t\t\t{format.name.replace('[Gen 8 ', '[').replace('[Gen 9] ', '').replace('[Gen 7 ', '[')}\r\n\t\t\t\t\t\t\t\t{format.section === 'No Format' && <em> {TL`(uncategorized)`}</em>}\r\n\t\t\t\t\t\t\t\t<i class=\"star fa fa-star-o\" data-cmd={`/star ${format.id}`}></i>\r\n\t\t\t\t\t\t\t</button></li>;\r\n\t\t\t\t\t\t} else {\r\n\t\t\t\t\t\t\treturn <li><h3>{format.section}</h3></li>;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t})}\r\n\t\t\t\t</ul>\r\n\t\t\t))}\r\n\t\t\t{noResults && <p><em>{searchID ? TL`No formats matching \"${searchID}\" found` : TL`No formats found`}</em></p>}\r\n\t\t\t<div style=\"float: left\"></div>\r\n\t\t</div></PSPanelWrapper>;\r\n\t}\r\n}\r\n\r\nPS.addRoomType(TeamDropdownPanel, FormatDropdownPanel);\r\n"],"mappings":"sSAAA;AACA;AACA;AACA;AACA;AACA,GALA;;;;;;;AAYaA,aAAa,qBAAAA,cAAA,GAAAA,aAAA;AAClBC,gBAAgB,CAAvB,QAAO,CAAAA,gBAAgBA,CAACC,IAAU,CAAE;AACnC,GAAM,CAAAC,IAAI,CAAGC,KAAK,CAACC,MAAM,CAACH,IAAI,CAACI,UAAU,CAAC;AAC1C,GAAM,CAAAC,GAAG,CAAGC,GAAG,CAACC,SAAS,CAACP,IAAI,CAACQ,MAAM,CAAC;AACtC,MAAO,CAAAN,KAAK,UAAO,CAACD,IAAI,CAAEI,GAAG,CAAC;AAC/B,CAAC,CAAAP,aAAA;AACMW,gBAAgB,CAAvB,QAAO,CAAAA,gBAAgBA,CAACC,KAAa,CAAoB,IAAlB,CAAAC,QAAQ,CAAAC,SAAA,CAAAC,MAAA,IAAAD,SAAA,MAAAE,SAAA,CAAAF,SAAA,IAAG,KAAK;AACtD,GAAI,CAACD,QAAQ,CAAE,MAAO,CAAAI,EAAE,CAACL,KAAK,CAACM,OAAO,CAACN,KAAK,CAAC;AAC7C,GAAI,CAAAO,GAAG,CAAG,EAAE,CAAC,QAAAC,GAAA,GAAAA,GAAA;AACMR,KAAK,CAAAG,MAAA,CAAAK,GAAA,GAAE,CAArB,GAAM,CAAAlB,IAAI,CAAIU,KAAK,CAAAQ,GAAA,CAAT;AACd,GAAM,CAAAV,MAAM,CAAGR,IAAI,CAACQ,MAAM,KAAOR,IAAI,CAACQ,MAAM,EAAGR,IAAI,CAACmB,KAAK,CAAG,MAAM,CAAG,EAAE,OAAO,EAAE;AAChF,GAAM,CAAAC,MAAM,CAAGpB,IAAI,CAACoB,MAAM,CAAMpB,IAAI