if(elem.getAttribute('data-href')){
return;
}
if(elem.className==='selectFolder'){
folder=elem.getAttribute('data-value')||'';
break;
}
if(elem.className==='folderlist'){
return;
}
elem=elem.parentElement;
}
if(folder===null)return;
e.preventDefault();
e.stopImmediatePropagation();
