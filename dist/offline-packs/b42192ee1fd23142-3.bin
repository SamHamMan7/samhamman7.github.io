			onKeyPress?: KeyboardEventHandler;
			onKeyPressCapture?: KeyboardEventHandler;
			onKeyUp?: KeyboardEventHandler;
			onKeyUpCapture?: KeyboardEventHandler;

			// Media Events
			onAbort?: GenericEventHandler;
			onAbortCapture?: GenericEventHandler;
